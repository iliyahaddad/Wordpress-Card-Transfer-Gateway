msgid "Receipt upload failed."
msgstr "بارگذاری رسید ناموفق بود."

msgid "Receipt must be 5 MB or smaller."
msgstr "حجم رسید باید حداکثر ۵ مگابایت باشد."

msgid "Only JPG, PNG, WebP or PDF receipts are allowed."
msgstr "فقط رسید با فرمت JPG، PNG، WebP یا PDF مجاز است."

msgid "This receipt file has already been used for another order. Please upload the correct receipt."
msgstr "این فایل رسید قبلاً برای سفارش دیگری استفاده شده است. لطفاً رسید صحیح را بارگذاری کنید."

msgid "Could not store the receipt. Please try again later."
msgstr "ذخیره رسید ممکن نشد. لطفاً بعداً دوباره تلاش کنید."

msgid "The uploaded receipt expired. Please upload it again."
msgstr "رسید بارگذاری‌شده منقضی شده است. لطفاً دوباره بارگذاری کنید."

msgid "Receipt upload is not available."
msgstr "بارگذاری رسید در دسترس نیست."

msgid "Too many uploads. Please try again later."
msgstr "تعداد بارگذاری‌ها زیاد است. بعداً دوباره تلاش کنید."

msgid "Customer uploaded a transfer receipt."
msgstr "مشتری رسید انتقال را بارگذاری کرد."

msgid "Receipt uploaded. It will be reviewed shortly."
msgstr "رسید بارگذاری شد و به‌زودی بررسی می‌شود."

msgid "Transfer receipt"
msgstr "رسید انتقال"

msgid "Current receipt: %s"
msgstr "رسید فعلی: %s"

msgid "Replace receipt"
msgstr "جایگزینی رسید"

msgid "Upload receipt"
msgstr "بارگذاری رسید"

msgid "JPG, PNG, WebP or PDF; maximum 5 MB. Do not upload card credentials."
msgstr "JPG، PNG، WebP یا PDF؛ حداکثر ۵ مگابایت. اطلاعات محرمانه کارت (CVV2 و رمز) را ارسال نکنید."

msgid "Security check failed."
msgstr "بررسی امنیتی ناموفق بود."

msgid "Not authorized."
msgstr "دسترسی مجاز نیست."

msgid "Receipt not found."
msgstr "رسید پیدا نشد."

msgid "When you pay by manual transfer we store the transfer reference, the optional sender name and last four card digits, and the receipt file you upload (in a private folder). If OCR is enabled by the store, the receipt image is sent to the configured OCR provider. If you pay with Stripe, card details are entered on Stripe and never reach this site."
msgstr ""

